# Copy this file to ".env" for local development and fill in real values.
# ".env" is git-ignored, so real keys are never committed.
# On Vercel, add the same two names under Settings -> Environment Variables.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key
